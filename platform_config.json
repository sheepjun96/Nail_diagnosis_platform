{
  "server": {
    "http_port": 3007,
    "bind_host": "127.0.0.1",
    "base_path": "/v2",
    "cors_origins": []
  },
  "storage": {
    "base_dir": "data/images",
    "max_upload_mb": 30,
    "max_image_pixels": 40000000
  },
  "ai": {
    "base_url": "http://127.0.0.1:8002",
    "timeout_seconds": 600,
    "cache_ttl_seconds": 86400,
    "device": "auto"
  },
  "models": {
    "nail_detector": {
      "path": "ai_models/yolov12.pt",
      "confidence": 0.25,
      "crop_margin": 1.5
    },
    "lesion_classifier": {
      "path": "ai_models/MedSigLIP",
      "format": "medsiglip_custom",
      "class_names": ["Normal", "melanonychia", "nail psoriasis", "onychomycosis"],
      "image_size": 448,
      "use_clahe": false,
      "vision_config": {
        "hidden_size": 1152,
        "intermediate_size": 4304,
        "num_hidden_layers": 27,
        "num_attention_heads": 16,
        "image_size": 448,
        "patch_size": 14,
        "hidden_act": "gelu_pytorch_tanh",
        "layer_norm_eps": 0.000001,
        "attention_dropout": 0.0
      },
      "normalization": {
        "mean": [0.5, 0.5, 0.5],
        "std": [0.5, 0.5, 0.5]
      }
    }
  }
}
