# python run_platform.py creates .env and generates the local service secrets.
COMPOSE_PROJECT_NAME=nail_platform
NAIL_BIND_HOST=127.0.0.1
NAIL_HTTP_PORT=3007
NEXT_PUBLIC_BASE_PATH=/v2
NAIL_PUBLIC_BASE_URL=http://localhost:3007
NAIL_ENABLE_DOCS=false

# Fresh installs use 8.4. Existing 8.0 volumes need an explicit, backed-up upgrade.
MYSQL_IMAGE=mysql:8.4
# Set only after independently checking the version of an existing untracked volume.
# NAIL_EXISTING_DB_IMAGE=mysql:8.0
DB_NAME=curaxel_skin
DB_USER=curaxel_user
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
REDIS_PASSWORD=
NAIL_INTERNAL_API_TOKEN=
NAIL_UPLOAD_API_KEY=

# Required for the existing Gachon SSO. Never point this to the new platform Redis.
GACHON_AUTH_DB_HOST=10.2.52.209
GACHON_AUTH_DB_PORT=3306
GACHON_AUTH_DB_NAME=mis_db
GACHON_AUTH_DB_USER=
GACHON_AUTH_DB_PASSWORD=
GACHON_REDIS_HOST=10.2.52.209
GACHON_REDIS_PORT=6379
GACHON_REDIS_DB=0
GACHON_REDIS_PASSWORD=
GACHON_SESSION_SECRET=
GACHON_BASE_URL=http://10.2.52.209
GACHON_SSO_FORCE_HTTP=false

# CPU inference works with the default image. GPU wheels require a separate build.
NAIL_AI_DEVICE=cpu
NAIL_TORCH_THREADS=4
NAIL_AI_TIMEOUT=600
NAIL_AI_MEMORY=6g
NAIL_AI_CPUS=4
