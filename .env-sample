HUGGINGFACE_HUB_TOKEN=your-token

HF_HOME=/root/.cache/huggingface
TRANSFORMERS_CACHE=/root/.cache/huggingface
NAIL_HTTP_PORT=3007
NAIL_PUBLIC_BASE_URL=http://localhost:3007
NAIL_APP_BASE_PATH=/v2/app
NEXT_PUBLIC_BASE_PATH=/v2
GACHON_AUTH_DB_HOST=10.2.52.209
GACHON_AUTH_DB_PORT=3306
GACHON_AUTH_DB_USER=root
GACHON_AUTH_DB_PASSWORD=
GACHON_AUTH_DB_NAME=mis_db
GACHON_REDIS_HOST=10.2.52.209
GACHON_REDIS_PORT=6379
GACHON_SESSION_SECRET=
# SSO는 HTTP(80)만 켜져 있는 경우가 많습니다. https로 리다이렉트되면 nginx 502가 날 수 있습니다.
# .env에 https로 적혀 있으면 http:// 로 바꾸거나 아래를 true로 두세요.
GACHON_BASE_URL=http://10.2.52.209
GACHON_SSO_FORCE_HTTP=true
